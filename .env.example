# NotionGraph — environment variables template
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser; everything else is server-only.

# ── Clerk (authentication) ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk sends sign-in/up users (defaults are fine for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Supabase (database) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — full DB access, keep secret

# ── Notion (data source, OAuth) ──────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback

# ── Trigger.dev (background sync jobs) ───────────────────────────────────
TRIGGER_SECRET_KEY=

# ── Encryption ───────────────────────────────────────────────────────────
# Used to encrypt Notion access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
