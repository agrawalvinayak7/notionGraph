# NotionGraph — environment variables template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser; everything else is server-only.

# ── Clerk (authentication) ───────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/graph
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/graph

# ── Supabase (database) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — full DB access, keep secret

# ── Notion (data source, OAuth) ──────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback

# ── Trigger.dev (background sync jobs) ───────────────────────────────────
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# ── Encryption ───────────────────────────────────────────────────────────
# Used to encrypt Notion access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
